        "measures": [
          {
            "name": "Households",
            "expression": [
              "COALESCE(COUNTROWS(FactHouseholdSnapshot), 0)"
            ],
            "formatString": "#,0",
            "displayFolder": "Households served"
          },
          {
            "name": "Households With Children",
            "expression": [
              "CALCULATE([Households], FactHouseholdSnapshot[HouseholdType] = \"With children\")"
            ],
            "formatString": "#,0",
            "displayFolder": "Households served"
          },
          {
            "name": "Households Without Children",
            "expression": [
              "CALCULATE([Households], FactHouseholdSnapshot[HouseholdType] = \"Without children\")"
            ],
            "formatString": "#,0",
            "displayFolder": "Households served"
          },
          {
            "name": "Elderly Households",
            "expression": [
              "CALCULATE([Households], FactHouseholdSnapshot[Category] = \"Elderly\")"
            ],
            "formatString": "#,0",
            "displayFolder": "Households served"
          },
          {
            "name": "Disabled Households",
            "expression": [
              "CALCULATE([Households], FactHouseholdSnapshot[Category] = \"Disabled\")"
            ],
            "formatString": "#,0",
            "displayFolder": "Households served"
          },
          {
            "name": "Workforce Households",
            "expression": [
              "CALCULATE([Households], FactHouseholdSnapshot[Category] = \"Workforce\")"
            ],
            "formatString": "#,0",
            "displayFolder": "Households served"
          }
        ],
