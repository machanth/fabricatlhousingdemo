    "roles": [
      {
        "name": "ProgramScope",
        "modelPermission": "read",
        "tablePermissions": [
          {
            "name": "DimProgramType",
            "filterExpression": [
              "VAR CurrentUPN = LOWER(USERPRINCIPALNAME())",
              "RETURN",
              "    COUNTROWS(",
              "        FILTER(",
              "            ProgramScope,",
              "            LOWER(ProgramScope[UserPrincipalName]) = CurrentUPN",
              "                && ProgramScope[ProgramTypeKey] = DimProgramType[ProgramTypeKey]",
              "        )",
              "    ) > 0"
            ]
          },
          {
            "name": "ProgramScope",
            "filterExpression": "LOWER(ProgramScope[UserPrincipalName]) = LOWER(USERPRINCIPALNAME())"
          }
        ]
      }
    ],
