          }
        ],
        "lineageTag": "b1db5a0d-5e71-4263-a298-f39d62534e2b",
        "measures": [
          {
            "name": "Available Units",
            "expression": [
              "SUM(FactUnitAvailability[AvailableUnits])"
            ],
            "formatString": "#,0",
            "displayFolder": "Households served"
          },
          {
            "name": "LIHTC Units",
            "expression": [
              "SUM(FactUnitAvailability[LIHTCUnits])"
            ],
            "formatString": "#,0",
            "displayFolder": "Households served"
          },
          {
            "name": "Total Units",
            "expression": [
              "SUM(FactUnitAvailability[TotalUnits])"
            ],
            "formatString": "#,0",
            "displayFolder": "Households served"
          },
          {
            "name": "Unit Based Households",
            "expression": [
              "CALCULATE([Households], KEEPFILTERS(DimProgramType[ProgramFamily] = \"Unit-based\"))"
            ],
            "formatString": "#,0",
            "displayFolder": "Households served"
          },
          {
            "name": "Vacant Units",
            "expression": [
              "IF(NOT ISBLANK([Available Units]), [Available Units] - [Unit Based Households])"
            ],
            "formatString": "#,0",
            "displayFolder": "Households served"
          },
          {
            "name": "Occupancy %",
            "expression": [
              "DIVIDE([Unit Based Households], [Available Units])"
            ],
            "formatString": "0.0%",
            "displayFolder": "Households served"
          },
          {
            "name": "DQ Flag",
            "expression": [
              "IF(NOT ISBLANK([Vacant Units]) && [Vacant Units] < 0, \"Over occupied\", BLANK())"
            ],
            "formatString": "#,0",
            "displayFolder": "Households served"
          },
          {
            "name": "Vacancy Color",
            "expression": [
              "IF(NOT ISBLANK([Vacant Units]) && [Vacant Units] < 0, \"#C00000\", \"#1F2937\")"
            ],
            "formatString": "#,0",
            "displayFolder": "Households served"
          }
        ],
        "partitions": [
          {
            "name": "FactUnitAvailability",
            "mode": "directLake",
            "source": {
              "entityName": "FactUnitAvailability",
              "expressionSource": "DirectLake - OneLake",
              "schemaName": "prd",
              "type": "entity"
            }
          }
        ],
        "sourceLineageTag": "[prd].[FactUnitAvailability]"
      },
