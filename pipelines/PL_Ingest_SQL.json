                        "annotations": [],
                        "type": "Lakehouse",
                        "typeProperties": {
                          "workspaceId": "4d77b5c8-d96f-41df-83e1-954c582336d8",
                          "artifactId": "b3fdd7c1-498f-45f6-82a6-3a1ed9fa2ae9",
                          "rootFolder": "Files"
                        }
                      }
                    },
                    "type": "Parquet",
                    "typeProperties": {
                      "location": {
                        "type": "LakehouseLocation",
                        "folderPath": {
                          "value": "@concat('landing/native_sql/',pipeline().RunId)",
                          "type": "Expression"
                        },
                        "fileName": {
                          "value": "@concat(item().TargetTable,'.parquet')",
                          "type": "Expression"
                        }
                      },
                      "compressionCodec": "snappy"
                    },
                    "schema": []
                  }
                },
                "enableStaging": false,
                "translator": {
                  "type": "TabularTranslator",
                  "typeConversion": true,
                  "typeConversionSettings": {
                    "allowDataTruncation": false,
                    "treatBooleanAsNumber": false
                  }
                }
              }
            },
            {
              "name": "Publish SQL table",
              "type": "Script",
              "policy": {
                "timeout": "0.01:00:00",
                "retry": 0,
                "retryIntervalInSeconds": 30,
                "secureInput": true,
                "secureOutput": false
              },
              "dependsOn": [
                {
                  "activity": "Land SQL table",
                  "dependencyConditions": [
                    "Succeeded"
                  ]
                }
              ],
              "linkedService": {
                "name": "WH_ATL_HS",
                "properties": {
                  "annotations": [],
                  "type": "DataWarehouse",
                  "typeProperties": {
                    "endpoint": "3wbf345z5tvelenl3cnua6iohy-zc2xotlp3hpuda7bsvgfqizw3a.datawarehouse.fabric.microsoft.com",
                    "artifactId": "81bc6f59-4979-447b-aa5c-041c0e52ced2",
                    "workspaceId": "4d77b5c8-d96f-41df-83e1-954c582336d8"
                  }
                }
              },
              "typeProperties": {
                "scripts": [
                  {
                    "type": "NonQuery",
                    "text": {
                      "value": "@concat('BEGIN TRY BEGIN TRANSACTION; DELETE FROM stg.[',item().TargetTable,']; COPY INTO stg.[',item().TargetTable,'] FROM ''https://onelake.dfs.fabric.microsoft.com/4d77b5c8-d96f-41df-83e1-954c582336d8/b3fdd7c1-498f-45f6-82a6-3a1ed9fa2ae9/Files/landing/native_sql/',pipeline().RunId,'/',item().TargetTable,'.parquet'' WITH (FILE_TYPE=''PARQUET''); IF (SELECT COUNT_BIG(*) FROM stg.[',item().TargetTable,']) <> ',string(activity('Land SQL table').output.rowsRead),' THROW 51020, ''Native copy row-count mismatch'', 1; COMMIT; END TRY BEGIN CATCH IF @@TRANCOUNT>0 ROLLBACK; THROW; END CATCH; EXEC mtd.usp_LogRun @RunId=''',pipeline().RunId,''',@Stage=''Native SQL: ',item().TargetTable,''',@Status=''Succeeded'',@Rows=',string(activity('Land SQL table').output.rowsRead),';')",
                      "type": "Expression"
                    }
                  }
                ],
                "scriptBlockExecutionTimeout": "00:30:00"
              }
            }
          ]
        }
