          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureInput": true,
          "secureOutput": false
        },
        "typeProperties": {
          "firstRowOnly": false,
          "source": {
            "type": "DataWarehouseSource",
            "sqlReaderQuery": "SELECT SourceSchema,SourceTable,TargetTable FROM mtd.TablesToCopy WHERE IsActive=1 AND LoadType='Full' AND SourceSchema='hs' AND SourceTable IN ('SourceSystem','ProgramType','VoucherType','ActionType','IncomeSource','Property','Unit','UnitLocation','Member','FamilyMember') AND TargetTable=SourceTable",
            "queryTimeout": "00:10:00",
            "partitionOption": "None"
          },
          "datasetSettings": {
            "annotations": [],
            "type": "DataWarehouseTable",
            "schema": [],
            "linkedService": {
              "name": "WH_ATL_HS",
              "properties": {
                "annotations": [],
                "type": "DataWarehouse",
                "typeProperties": {
                  "endpoint": "3wbf345z5tvelenl3cnua6iohy-zc2xotlp3hpuda7bsvgfqizw3a.datawarehouse.fabric.microsoft.com",
                  "artifactId": "81bc6f59-4979-447b-aa5c-041c0e52ced2",
                  "workspaceId": "4d77b5c8-d96f-41df-83e1-954c582336d8"
                }
              }
            }
          }
        }
      },
      {
        "name": "ForEach SQL table",
