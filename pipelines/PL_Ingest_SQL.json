                "secureInput": true,
                "secureOutput": false
              },
              "typeProperties": {
                "source": {
                  "type": "AzureSqlSource",
                  "sqlReaderQuery": {
                    "value": "@concat('SELECT * FROM [hs].[',item().SourceTable,']')",
                    "type": "Expression"
                  },
                  "queryTimeout": "00:30:00",
                  "partitionOption": "None",
                  "datasetSettings": {
                    "annotations": [],
                    "type": "AzureSqlTable",
                    "schema": [],
                    "externalReferences": {
                      "connection": "657464b8-b9dd-4cd9-a4d2-8c36bfe145a0"
                    }
                  }
                },
                "sink": {
                  "type": "ParquetSink",
                  "storeSettings": {
                    "type": "LakehouseWriteSettings"
