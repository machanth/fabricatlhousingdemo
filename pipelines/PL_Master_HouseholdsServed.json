        "linkedService": {
          "name": "WH_ATL_HS",
          "properties": {
            "annotations": [],
            "type": "DataWarehouse",
            "typeProperties": {
              "endpoint": "3wbf345z5tvelenl3cnua6iohy-zc2xotlp3hpuda7bsvgfqizw3a.datawarehouse.fabric.microsoft.com",
              "artifactId": "81bc6f59-4979-447b-aa5c-041c0e52ced2",
              "workspaceId": "4d77b5c8-d96f-41df-83e1-954c582336d8"
            }
          }
        },
        "typeProperties": {
          "scripts": [
            {
              "type": "NonQuery",
              "text": "IF LEN(@EffectiveMonth)<>7 OR TRY_CONVERT(date,@EffectiveMonth+'-01',23) IS NULL THROW 51021,'EffectiveMonth must be YYYY-MM.',1; IF NOT EXISTS (SELECT 1 FROM stg.AnswerKey WHERE EffectiveDateKey=CONVERT(int,REPLACE(@EffectiveMonth,'-','')+'01')) THROW 51022,'Reporting month is absent from the approved demo control.',1; DECLARE @Stage varchar(100)=CONCAT('Master report month: ',@EffectiveMonth); EXEC mtd.usp_LogRun @RunId=@RunId,@Stage=@Stage,@Status='Succeeded';",
              "parameters": [
                {
                  "name": "EffectiveMonth",
                  "type": "String",
                  "direction": "Input",
                  "value": {
                    "value": "@pipeline().parameters.EffectiveMonth",
                    "type": "Expression"
                  }
                },
                {
                  "name": "RunId",
                  "type": "String",
                  "direction": "Input",
                  "value": {
                    "value": "@pipeline().RunId",
                    "type": "Expression"
                  }
                }
              ]
            }
          ],
          "scriptBlockExecutionTimeout": "00:05:00"
        }
      },
